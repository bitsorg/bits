# Makeflow template

{% for (p, build_command, tar_command, upload_command, cachedTarball, breq, checkout_cmd) in ToDo %}
{% if checkout_cmd %}
{{p}}.checkout:
   LOCAL {{checkout_cmd}} && touch {{p}}.checkout

{% endif %}
{{p}}.build:  {% if checkout_cmd %}{{p}}.checkout {% endif %}{{breq}}
   LOCAL {{build_command}} && touch {{p}}.build

{% if tar_command %}
{{p}}.tar:  {{p}}.build
   LOCAL {{tar_command}} && touch {{p}}.tar

{% if upload_command %}
{{p}}.upload:  {{p}}.tar
   LOCAL {{upload_command}} && touch {{p}}.upload

{% endif %}
{% endif %}
{% endfor %}
