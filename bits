function installHint() {
  if [[ $UNAME == Darwin ]]; then
    CMD='brew install modules'
  elif command -v apt-get > /dev/null 2>&1; then
    CMD='apt-get install environment-modules'
  elif command -v yum > /dev/null 2>&1; then
    CMD='yum install environment-modules'
  fi
  printf "${ER}ERROR: Environment Modules was not found on your system.\n" >&2
  if [[ -z "$CMD" ]]; then
    printf "       The package is usually called ${EM}environment-modules${ER}.\n" >&2
  else
    printf "       Get it with: ${EM}${CMD}\n" >&2
  fi
  printf "${EZ}"
}

function detectShell() {
  # Detect parent shell (fall back to bash)
  [[ -z "$MODULES_SHELL" ]] && MODULES_SHELL=$(ps -e -o pid,command | grep -E "^\s*$PPID\s+" | awk '{print $2}' | sed -e 's/^-\{0,1\}\(.*\)$/\1/')
  case "$MODULES_SHELL" in
    sh)                                      ;;
    csh|tcsh) SHELL_NORC_PARAM=-f            ;;
    ksh)      SHELL_NORC_ENV="ENV=/dev/null" ;;
    zsh)      SHELL_NORC_PARAM=--no-rcs      ;;
    *)        MODULES_SHELL=bash
              SHELL_NORC_PARAM=--norc        ;;
  esac
}

function _listPkgVersions() {
  # Emit the <pkg>/<version> directories under the install tree (the input the
  # module-collection loop consumes).
  #
  # With BITS_CATALOG_LISTING=1 and the tree on CVMFS, first ask its serving
  # catalog via the bitsModules helper (one HTTP fetch + a local SQLite query);
  # it exits non-zero (fall-back contract) when its single-dedicated-catalog
  # convention does not hold. Off by default: a warm `find` is faster than the
  # helper's Python start (see catalogListing).
  local dir="$1" real bm
  real=$(readlink -f "$dir" 2> /dev/null || echo "$dir")
  if catalogListing && [[ "$real" == /cvmfs/* ]]; then
    if [[ -n "$BITS_PY" ]]; then bm="${BITSDIR}/bitsModules"
    else bm=$(command -v bitsModules 2> /dev/null || echo "${BITSDIR}/bitsModules"); fi
    if [[ -x "$bm" ]] && ${BITS_PY:+"$BITS_PY" -E -s} "$bm" "$dir" --depth2-dirs 2> /dev/null; then
      return 0
    fi
  fi
  find "$dir" -maxdepth 2 -mindepth 2 2> /dev/null
}

function collectModules() {
  if [[ -n "$NO_REFRESH" ]]; then
    printf "${EY}WARNING: not updating modulefiles${EZ}\n" >&2
    return 0
  fi
  # Guard against empty variables before any rm to prevent accidental deletion
  # of paths like /MODULES/ if WORK_DIR or ARCHITECTURE is unset.
  [[ -n "$WORK_DIR" && -n "$ARCHITECTURE" ]] || \
    { printf "${ER}ERROR: WORK_DIR or ARCHITECTURE is empty; cannot refresh modules${EZ}\n" >&2; return 1; }
  local mroot="${WORK_DIR}/MODULES/${ARCHITECTURE}"
  local iroot="${WORK_DIR}/${ARCHITECTURE}"
  local stamp="$mroot/.bits_sync_stamp"
  mkdir -p "$mroot/BASE"
  cat > "$mroot/BASE/1.0" <<EOF
#%Module1.0
set base_path ${iroot}
setenv BASEDIR \$base_path
set osname [uname sysname]
set osarchitecture [uname machine]
EOF
  # Fast skip: the per-package stat/copy walk below is O(N) and, on a slow
  # filesystem, dominates load/enter (seconds). If nothing in the install tree
  # has changed since the last successful sync, the cache is already current —
  # detect that with one shallow `find -newer` (the same cheap traversal as a
  # bare find) and return. -maxdepth 2 includes the arch dir and the per-package
  # dirs, so package add/remove and version re-symlinks all bump a checked mtime.
  if [[ -f "$stamp" ]] && \
     [[ -z "$(find "$iroot" -maxdepth 2 -newer "$stamp" 2> /dev/null | head -1)" ]]; then
    return 0
  fi
  # Incremental sync: copy a modulefile into the cache only when it is missing
  # or newer than the cached copy, then drop cache entries whose source has
  # vanished. After a build with no module changes this copies nothing.
  local PKG PKGVER PKGNAME src dest
  while read -r PKG; do
    [[ -n "$PKG" ]] || continue
    PKGVER=${PKG##*/}
    PKGNAME=${PKG%/*}; PKGNAME=${PKGNAME##*/}
    src="$PKG/etc/modulefiles/$PKGNAME"
    [[ -e "$src" ]] || continue
    dest="$mroot/$PKGNAME/$PKGVER"
    if [[ ! -e "$dest" || "$src" -nt "$dest" ]]; then
      mkdir -p "$mroot/$PKGNAME"
      cp "$src" "$dest"
    fi
  done < <(_listPkgVersions "$iroot")
  # Prune cache entries whose source modulefile no longer exists (deleted
  # package/version). Walk the (small) cache tree with plain find — no GNU
  # -printf, for macOS portability.
  local DESTFILE rel pkg ver d
  while read -r DESTFILE; do
    [[ -n "$DESTFILE" ]] || continue
    rel=${DESTFILE#"$mroot/"}
    pkg=${rel%/*}; ver=${rel##*/}
    [[ "$pkg" == BASE ]] && continue
    [[ -e "$iroot/$pkg/$ver/etc/modulefiles/$pkg" ]] || rm -f "$DESTFILE"
  done < <(find "$mroot" -mindepth 2 -maxdepth 2 -type f 2> /dev/null)
  # Remove now-empty package directories (rmdir only deletes empties; keep BASE).
  for d in "$mroot"/*/; do
    [[ "$(basename "$d")" == BASE ]] && continue
    rmdir "$d" 2> /dev/null || true
  done
  # Stamp the sync so the next call can fast-skip when nothing changed.
  : > "$stamp" 2> /dev/null || true
}

function listAvailableModules() {
  # Emit <pkg>/<version> for every installed package that ships a modulefile,
  # read straight from the install tree (the source of truth) via the same fast
  # path collectModules uses. This is what `bits q` lists: it avoids rebuilding
  # the MODULES cache (rm -rf + re-cp of every modulefile) and spawning
  # `modulecmd avail` just to enumerate — the two costs that make `q` slow on a
  # real filesystem. Output is unsorted; callers pipe through sort.
  local base="${WORK_DIR}/${ARCHITECTURE}" P pkgver pkgname
  [[ -d "$base" ]] || return 0
  while read -r P; do
    [[ -n "$P" ]] || continue
    pkgver=${P##*/}
    pkgname=${P%/*}; pkgname=${pkgname##*/}
    [[ -e "$P/etc/modulefiles/$pkgname" ]] && printf '%s/%s\n' "$pkgname" "$pkgver"
  done < <(_listPkgVersions "$base")
}

function normModules() {
  # Avoid interpolating $BITS_PKG_PREFIX into a sed expression: if the
  # prefix contains sed metacharacters or the delimiter it can inject
  # arbitrary sed commands.  Use pure bash string operations instead.
  local input="${*//,/ }"   # replace commas with spaces
  local result=()
  local token
  for token in $input; do
    token="${token#"${BITS_PKG_PREFIX}@"}"  # strip package prefix
    token="${token//::///}"                  # :: → /
    result+=("$token")
  done
  echo "${result[*]}"
}

function layoutValue() {
  # layoutValue FILE KEY: the value of a top-level `KEY: value` line of a
  # cvmfs.yaml (unquoted, without a trailing comment), empty if none.
  awk -v k="$2" 'index($0, k ":") == 1 {
      v = substr($0, length(k) + 2)
      sub(/^[ \t]+/, "", v); sub(/[ \t]+#.*$/, "", v); sub(/[ \t]+$/, "", v)
      if (v ~ /^".*"$/ || v ~ /^\047.*\047$/) v = substr(v, 2, length(v) - 2)
      print v; exit }' "$1"
}

function publishedArchs() {
  # publishedArchs TREE: the archs that have a module tree, TREE being its path
  # with {arch} in place of the arch.
  local pre=${1%%"{arch}"*} post=${1#*"{arch}"} d
  for d in "$pre"*; do [[ -d "$d$post" ]] && echo "${d#"$pre"}"; done
}

function hostCvmfsArch() {
  # hostCvmfsArch TREE: the published build arch (without -opt/-dbg) for this
  # host's CPU and OS, when exactly one matches; as the CVMFS entry point picks
  # its view: the CPU token, and el<N> (or slc/alma/rhel/rocky/centos<N>) or
  # ubuntu<NNNN> from /etc/os-release.
  local cpu os a b bases=()
  cpu=$(uname -m)
  os=$( . /etc/os-release 2> /dev/null
        if [[ ${PLATFORM_ID:-} =~ ^platform:(el[0-9]+)$ ]]; then echo "${BASH_REMATCH[1]}"
        elif [[ ${ID:-} == ubuntu ]]; then echo "ubuntu${VERSION_ID//./}"
        fi )
  [[ -n "$os" ]] || return 0
  while read -r a; do
    [[ "$a" == *"$cpu"* || "$a" == *"${cpu/_/-}"* ]] || continue
    case $os in
      el*) [[ "$a" =~ (^|[-_])(el|slc|alma|rhel|rocky|centos)${os#el}([-_]|$) ]] || continue ;;
      *)   [[ "$a" =~ (^|[-_])$os([-_]|$) ]] || continue ;;
    esac
    b=${a%-opt}; b=${b%-dbg}
    [[ " ${bases[*]} " == *" $b "* ]] || bases+=("$b")
  done < <(publishedArchs "$1")
  (( ${#bases[@]} == 1 )) && echo "${bases[0]}"
  return 0
}

function isModuleAction() {
  case "$ACTION" in q|query|enter|printenv|load|setenv) return 0 ;; esac
  return 1
}

function cvmfsTrees() {
  # cvmfsTrees TREE ARCH: add to CVMFS_TREES the trees (TREE with {arch}) of
  # ARCH, of ARCH without its -opt/-dbg, then of that with -opt and -dbg.
  local a b t
  b=${2%-opt}; b=${b%-dbg}
  for a in "$2" "$b" "$b-opt" "$b-dbg"; do
    t=${1//"{arch}"/"$a"}
    [[ -d "$t" ]] || continue
    # Physical, as BASE/1.0 resolves its BASEDIR (file normalize): the same
    # paths whether BASE is loaded in the same run or was loaded before.
    t=$(cd "$t" && pwd -P)
    [[ " ${CVMFS_TREES[*]} " == *" $t "* ]] || CVMFS_TREES+=("$t")
  done
  return 0
}

function catalogListing() {
  # Whether to try the bitsModules catalog listing (BITS_CATALOG_LISTING=1).
  # Kept for later (e.g. selecting modules in SQL), but off: a directory walk
  # over a warm CVMFS cache takes milliseconds, the helper a Python start, and
  # it needs one catalog rooted at the tree with none nested below it.
  [[ "${BITS_CATALOG_LISTING:-}" == 1 ]]
}

function listCvmfsModules() {
  # Emit <pkg>/<version> for every modulefile in the CVMFS module trees (no
  # BASE), with find, or first the serving catalog (catalogListing).
  local t bm=
  (( ${#CVMFS_TREES[@]} )) || return 0
  if ! catalogListing; then :
  elif [[ -n "$BITS_PY" ]]; then bm="${BITSDIR}/bitsModules"
  else bm=$(command -v bitsModules 2> /dev/null || echo "${BITSDIR}/bitsModules"); fi
  for t in "${CVMFS_TREES[@]}"; do
    { [[ -n "$bm" && -x "$bm" ]] && ${BITS_PY:+"$BITS_PY" -E -s} "$bm" "$t" 2> /dev/null; } ||
      ( cd "$t" && find . -mindepth 2 -maxdepth 2 \( -type f -o -type l \) | sed -e 's|^\./||' )
  done | grep -E '^[^/.][^/]*/[^/.][^/]*$' | grep -v '^BASE/' || true
}

function resolveModules() {
  # Find the module tree of each module <pkg>[/<version>]: the local MODULEPATH
  # (the modulefile cache, reuse overlays, the user's own entries), then the
  # CVMFS trees in order; the first that has it wins. <pkg>/<version> is a
  # file there, a bare <pkg> a directory. Testing that directly is instant;
  # `modulecmd avail` (a full scan) runs only when no tree has it, so
  # default-version aliases still resolve locally. The `..` guard keeps the
  # direct test from matching path-traversal names (modulecmd rejects them).
  # Sets GROUP_TREE (a CVMFS tree, or "" for the local MODULEPATH) and
  # GROUP_MODS (its modules, space-separated), one entry per tree used, in tree
  # order.
  local M t i found mp trees=("" "${CVMFS_TREES[@]}") mods=()
  IFS=: read -r -a mp <<< "$MODULEPATH"
  for t in "${trees[@]}"; do mods+=(""); done
  for M in "$@"; do
    found=
    if [[ "$M" != *..* ]]; then
      for t in "${mp[@]}"; do [[ -n "$t" && -e "$t/$M" ]] && { found=0; break; }; done
      for ((i = 1; i < ${#trees[@]} && ${#found} == 0; i++)); do
        [[ -e "${trees[i]}/$M" ]] && found=$i
      done
    fi
    [[ -z "$found" ]] && $MODULECMD bash -t avail 2>&1 | grep -qFx "$M" && found=0
    [[ -n "$found" ]] || { printf "${ER}ERROR: $M was not found${EZ}\n" >&2; return 1; }
    mods[found]+="${mods[found]:+ }$M"
  done
  GROUP_TREE=(); GROUP_MODS=()
  for ((i = 0; i < ${#trees[@]}; i++)); do
    [[ -n "${mods[i]}" ]] && { GROUP_TREE+=("${trees[i]}"); GROUP_MODS+=("${mods[i]}"); }
  done
  return 0
}

function resolveLoaded() {
  # For unload: group the modules by the tree they were loaded from, read from
  # _LMFILES_ (<tree>/<pkg>/<version>); any other module, e.g. one no tree has
  # any more, goes with the local MODULEPATH, as before. Sets GROUP_TREE and
  # GROUP_MODS as resolveModules does.
  local M f t i found lm trees=("" "${CVMFS_TREES[@]}") mods=()
  IFS=: read -r -a lm <<< "${_LMFILES_:-}"
  for t in "${trees[@]}"; do mods+=(""); done
  for M in "$@"; do
    found=0
    for ((i = 1; i < ${#trees[@]} && found == 0; i++)); do
      for f in "${lm[@]}"; do
        [[ "$f" == "${trees[i]}/$M" || "$f" == "${trees[i]}/$M/"* ]] && { found=$i; break; }
      done
    done
    mods[found]+="${mods[found]:+ }$M"
  done
  GROUP_TREE=(); GROUP_MODS=()
  for ((i = 0; i < ${#trees[@]}; i++)); do
    [[ -n "${mods[i]}" ]] && { GROUP_TREE+=("${trees[i]}"); GROUP_MODS+=("${mods[i]}"); }
  done
  return 0
}

function localOnly() {
  # --dev sources the packages' own init.sh from the work directory: local
  # modules only.
  local i cv=
  for ((i = 0; i < ${#GROUP_TREE[@]}; i++)); do
    [[ -n "${GROUP_TREE[i]}" ]] && cv+=" ${GROUP_MODS[i]}"
  done
  [[ -z "$cv" ]] && return 0
  printf "${ER}ERROR: --dev works with local modules only, not with CVMFS ones:%s${EZ}\n" "$cv" >&2
  return 1
}

function groupModulecmd() {
  # groupModulecmd SHELL ACTION I: modulecmd for the modules of group I against
  # their tree alone (MODULEPATH = that tree, the local one as it is), so their
  # dependencies come from the same tree. BASEDIR is set to the tree's packages:
  # bits modulefiles find their package through it, and those of a second tree
  # skip their BASE/1.0 when the first tree's is loaded already.
  local t="${GROUP_TREE[$3]}"
  if [[ -z "$t" ]]; then
    BASEDIR="${WORK_DIR}/${ARCHITECTURE}" $MODULECMD "$1" "$2" ${GROUP_MODS[$3]}
  else
    MODULEPATH="$t" BASEDIR="${t%/Modules/modulefiles}/Packages" $MODULECMD "$1" "$2" ${GROUP_MODS[$3]}
  fi
}

function evalGroups() {
  # evalGroups ACTION: apply every group in this shell, in order, each on the
  # result of the previous one. After CVMFS groups BASEDIR is the local one
  # again, so that a local module loaded by hand later (BASE/1.0 being loaded
  # already) finds its package.
  local i
  for ((i = 0; i < ${#GROUP_TREE[@]}; i++)); do
    eval "$(groupModulecmd bash "$1" "$i" 2> >(grep -v "$IGNORE_ERR" >&2))"
  done
  [[ -z "${GROUP_TREE[*]}" ]] || export BASEDIR="${WORK_DIR}/${ARCHITECTURE}"
}

function printGroups() {
  # printGroups ACTION: print every group's commands for $MODULES_SHELL. Each
  # group is run after the previous one is applied here, and modulecmd prints
  # whole values, so the output evaluated in order gives what evalGroups gives.
  local i n=${#GROUP_TREE[@]}
  for ((i = 0; i < n; i++)); do
    groupModulecmd "$MODULES_SHELL" "$1" "$i" 2> >(grep -v "$IGNORE_ERR" >&2)
    (( i + 1 < n )) && eval "$(groupModulecmd bash "$1" "$i" 2> /dev/null)"
  done
  return 0
}

function stripDyld() {
  # Succeeds with nothing to strip too: callers run under set -e.
  TO_STRIP=$( (typeset | grep ^DYLD | cut -d= -f1 | grep '_modshare$' | xargs echo ) 2> /dev/null )
  if [ -n "$TO_STRIP" ]; then echo unset $TO_STRIP; echo ';'; fi
}

function _bt_mark() {
  # Print elapsed wall time since the previous mark (only when BITS_TIMING set).
  [[ -n "${BITS_TIMING:-}" ]] || return 0
  local now="${EPOCHREALTIME/,/.}"; now="${now:-$(date +%s.%N 2>/dev/null || echo 0)}"
  [[ -n "${_BT_PREV:-}" ]] && \
    awk -v a="$_BT_PREV" -v b="$now" -v l="$1" 'BEGIN{printf "[timing] %-14s %7.3fs\n", l, b-a}' >&2
  _BT_PREV="$now"
}

function configBits() {
  # The work-directory default plus the display prefix (BITS_PKG_PREFIX) and
  # branding come from the ENVIRONMENT only — the aliBuild wrapper exports them
  # for ALICE-style "VO_ALICE@pkg::ver" output; an empty BITS_PKG_PREFIX makes
  # `bits q` print the native "<pkg>/<version>". config_dir/architecture/
  # providers/... are handled by the Python layer (-w overrides BITS_WORK_DIR).
  export BITS_WORK_DIR=${BITS_WORK_DIR:-"sw"}
  export BITS_PKG_PREFIX=${BITS_PKG_PREFIX:-}
}

configBits

# Deprecated command aliases: warn once and forward to the grouped
# form. One arm per alias — retiring one is deleting its arm. Kept one release
# for callers in sibling repos. Runs before the group arms
# below so a rewritten command flows into the right one.
case "${1:-}" in
  cvmfs-stage)
    echo "warning: 'bits cvmfs-stage' is deprecated; use 'bits cvmfs stage'" >&2
    shift; set -- cvmfs stage "$@" ;;
  cvmfs-publish)
    echo "warning: 'bits cvmfs-publish' is deprecated; use 'bits cvmfs publish'" >&2
    shift; set -- cvmfs publish "$@" ;;
  store-stats)
    echo "warning: 'bits store-stats' is deprecated; use 'bits store stats'" >&2
    shift; set -- store stats "$@" ;;
esac

# `bits store …` → bitsStore (S3 content-store inspection, verification, cleanup).
# Handled before work-dir/module setup: the store tool talks to S3, not the local
# install tree, so it needs neither a work dir nor an architecture. The leading
# "store" token is dropped; everything after it is passed through verbatim.
if [[ "${1:-}" == "store" ]]; then
  shift
  exec "$BITSDIR/bitsStore" "$@"
fi

# `bits use …` → save/show/clear a per-directory arg profile (./.bitsuse, or a
# ~/.bits/use record when the cwd is not writeable), so repeated commands stay
# short (the injection at the top of this script consumes it). Handled here,
# before work-dir/module setup: it only touches the profile.
if [[ "${1:-}" == "use" ]]; then
  shift
  BITS_SELF="${BITSDIR}" exec "${BITS_PY:-python3}" ${BITS_PY:+-E -s} -c 'import os,sys; sys.path.insert(0, os.environ.get("BITS_SELF","")); from bits_helpers.bits_use import main; sys.exit(main())' "$@"
fi

# `bits cvmfs {platforms,show,summary,stage,publish} …` → the CVMFS group.
# platforms/show/summary read a deployed tree (no work dir); stage/publish are
# the producer-side ops, delegated inside cvmfs_inspect.main to their
# own CLIs. Handled here, before work-dir/module setup: it talks to the tree /
# S3, not the local install tree.
if [[ "${1:-}" == "cvmfs" ]]; then
  shift
  BITS_SELF="${BITSDIR}" exec "${BITS_PY:-python3}" ${BITS_PY:+-E -s} -c 'import os,sys; sys.path.insert(0, os.environ.get("BITS_SELF","")); from bits_helpers.cvmfs_inspect import main; sys.exit(main())' "$@"
fi

for arg in "$@"
do
  case $arg in
    architecture|brew|build|certify|checksums|clean|cleanup|prune|compliance|cvmfs-path|deps|doctor|import|init|publish|sbom|sign|stats|status|verify|version|-debug|-d)
         mkdir -p "$BITS_WORK_DIR" || echo "Cannot create directory: $BITS_WORK_DIR"
        ${BITS_PY:+"$BITS_PY" -E -s} "$BITSDIR/bitsBuild" "$@"
	    exit $?
        ;;
    -n|--dry-run|--version)
        ${BITS_PY:+"$BITS_PY" -E -s} "$BITSDIR/bitsBuild" "$@"
	    exit $?
        ;;
        *)
	    break
        ;;
  esac
done

# If we are on a TTY, enable colors
if test -t 1; then
  EM=`printf '\033[35m'`  # magenta
  ET=`printf '\033[36m'`  # cyan
  ER=`printf '\033[31m'`  # red
  EY=`printf '\033[33m'`  # yellow
  EZ=`printf '\033[m'`    # reset
else
  EM=
  ET=
  ER=
  EY=
  EZ=
fi

# My operating system

UNAME=$(uname)

ARCHITECTURE=
WORK_DIR=
NO_REFRESH=
DEFAULT_WORK_DIRS=("$BITS_WORK_DIR" "$BITS_WORK_DIR" ${BITSBUILD_CHDIR:+"$BITSBUILD_CHDIR/sw"} sw ../sw)
COMMAND_IN_ENV=()
CLEAN_ENV=1
DEVOPT=0
VIEWOPT=0
VERBOSE=1

ARGS=()

for ((i=0;i<$ARGC;i++));
do
  case "${ARGV[$i]}" in
      --architecture|-a)
	  i=$((i+1)); ARCHITECTURE="${ARGV[$i]}";;
      --work-dir|-w)
	  i=$((i+1)); WORK_DIR="${ARGV[$i]}";;
      --no-refresh)
	  NO_REFRESH=1;;
      -q)
	  unset VERBOSE;;
      --shellrc)
	  unset CLEAN_ENV;;
      --dev)
	  DEVOPT=1;;
      --view)
	  VIEWOPT=1;;
      -h|--help|help)
	  printHelp; exit 0 ;;
      -c) 
	  i=$((i+1)); COMMAND_IN_ENV=("${ARGV[@]:${i}}");
	  break ;;
      *)
	  ARGS+=("${ARGV[$i]}");;
   esac
done

ACTION="${ARGS[0]}"

ARGS=("${ARGS[@]:1}")

export BITSLVL=$((BITSLVL+1))

if [[ "$ACTION" == "shell-helper" ]]; then
cat <<\EOF
# Source this file from your .bashrc, .zshrc or .kshrc.
BITS_ENV__="$BITS_ENV"
if test -z "$BITS_ENV__"; then
  BITS_ENV__=`unset bits; export LC_ALL=C; export LANG=C; type -p bits | sed -e 's/^bits is //g' 2> /dev/null`
fi
bits() {
  if test -z "$BITS_ENV__"; then
    echo "bits not found"
    return 1
  fi
  for A in "$@"; do
    if ! test `echo "$A" | cut -b1` = -; then
      if test "$A" = load || test "$A" = unload; then
        unset A
        eval `"$BITS_ENV__" "$@"`
        return $?
      else
        break
      fi
    elif test "$A" = -c; then
      break
    fi
  done
  unset A
  "$BITS_ENV__" "$@"
}
EOF
  exit 0
fi

if [[ -z "$WORK_DIR" ]]; then
  for WORK_DIR in "${DEFAULT_WORK_DIRS[@]}"; do
    [[ -d "$WORK_DIR" ]] && break || WORK_DIR=
  done
  [[ -z "$WORK_DIR" ]] && { printHelp "No default work dir can be accessed:"                      \
                                      "export \$BITS_WORK_DIR or run bits from a directory" \
                                      "containing the \"sw\" dir"; false; }
fi
[[ ! -d "$WORK_DIR" ]] && { printHelp "Work dir $WORK_DIR cannot be accessed"; false; }
WORK_DIR=$(cd "$WORK_DIR"; pwd)
# Remember whether the architecture was given explicitly (-a); if so, respect it
# verbatim and never second-guess it below.
_bt_mark startup            # script start → here (configBits, option/work-dir parsing)
_ARCH_GIVEN=; [[ -n "$ARCHITECTURE" ]] && _ARCH_GIVEN=1
# Architecture autodetection (when -a not given). MODULES-first: for q/load/enter
# the installed module trees are the source of truth, so choose from them
# directly and skip the bitsBuild (python) host-arch spawn entirely in the common
# single-arch case. A real arch has a $WORK_DIR/MODULES/<arch> dir; sw/ also holds
# non-arch dirs (wrapper-scripts) which are excluded by going via MODULES. Fall
# back to python only to disambiguate several installed arches (prefer the host's)
# or when nothing is installed yet (e.g. a first build).
if [[ -z "$_ARCH_GIVEN" ]]; then
  # A real arch dir carries a CPU token (x86-64/aarch64/arm64/ppc64...). The
  # reuse-from-modules overlays live under MODULES/<build_id>/<arch>, so MODULES/
  # can also hold <build_id> dirs with no CPU token — exclude those so an overlay
  # is never mistaken for an architecture.
  _present=()
  for _a in $(ls -1t "$WORK_DIR/MODULES" 2> /dev/null); do
    [[ -d "$WORK_DIR/MODULES/$_a" ]] || continue
    [[ "$_a" =~ (x86[-_]64|aarch64|arm64|ppc64le|ppc64) ]] || continue
    _present+=("$_a")
  done
  if [[ ${#_present[@]} -eq 1 ]]; then
    ARCHITECTURE="${_present[0]}"            # sole installed arch — no python spawn
  elif [[ ${#_present[@]} -gt 1 ]]; then
    # Several present: prefer the host's native arch if installed.
    _host="$( { [[ -z "$BITS_PY" ]] && "bitsBuild" architecture 2> /dev/null; } ||
              ${BITS_PY:+"$BITS_PY" -E -s} "$BITSDIR/bitsBuild" architecture 2> /dev/null || true)"
    ARCHITECTURE=
    if [[ -n "$_host" ]]; then
      for _a in "${_present[@]}"; do [[ "$_a" == "$_host" ]] && { ARCHITECTURE="$_a"; break; }; done
    fi
    # No host match (or the host-arch probe momentarily failed → empty $_host):
    # do not blindly pick the newest tree — prefer an arch whose module tree
    # actually holds the requested package, so a failed probe cannot send
    # q/enter/load to a tree that lacks the module.
    if [[ -z "$ARCHITECTURE" ]]; then
      _want=
      for _m in "${ARGS[@]}"; do [[ "$_m" == -* ]] && continue; _want="${_m%%/*}"; break; done
      if [[ -n "$_want" ]]; then
        for _a in "${_present[@]}"; do
          [[ -d "$WORK_DIR/MODULES/$_a/$_want" ]] && { ARCHITECTURE="$_a"; break; }
        done
      fi
    fi
    if [[ -z "$ARCHITECTURE" ]]; then
      ARCHITECTURE="${_present[0]}"          # ls -1t → most recently built
      printf "${EY}NOTE: several architectures present; selected most recent: %s${EZ}\n" "$ARCHITECTURE" >&2
      printf "${EY}      (override with  bits -a <arch> %s)${EZ}\n" "${ACTION:-q}" >&2
    fi
  else
    # Nothing installed yet → host arch from python (e.g. for a first build).
    ARCHITECTURE="$([[ -z "$BITS_PY" ]] && "bitsBuild" architecture 2> /dev/null || true)"
    [[ -z "$ARCHITECTURE" ]] && ARCHITECTURE="$(${BITS_PY:+"$BITS_PY" -E -s} "$BITSDIR/bitsBuild" architecture 2> /dev/null || true)"
  fi
fi
_bt_mark archdetect         # arch autodetect (python spawn only when needed)
[[ -z "$ARCHITECTURE" ]] && { printHelp "Cannot autodetect architecture"; false; }

# Look for modulecmd (v3) or modulecmd-compat (>= v4): bits' own runtime first
MODULECMD="$BITSDIR/runtime/bin/modulecmd"
[[ -x "$MODULECMD" ]] || MODULECMD=$(command -v modulecmd 2> /dev/null || true)
[[ -x "$MODULECMD" ]] || MODULECMD="$(dirname $(command -v envml 2> /dev/null || true) 2> /dev/null || true)/../libexec/modulecmd-compat"
[[ -x "$MODULECMD" ]] || MODULECMD="$(brew --prefix modules 2> /dev/null || true)/libexec/modulecmd-compat"
[[ -x "$MODULECMD" ]] || { installHint; false; }

if [[ -d "${WORK_DIR}/MODULES/${ARCHITECTURE}" ]]; then
  touch "${WORK_DIR}/MODULES/${ARCHITECTURE}/.testwrite" 2> /dev/null || NO_REFRESH=1
  rm -f "${WORK_DIR}/MODULES/${ARCHITECTURE}/.testwrite" 2> /dev/null || true
fi

# Reuse-from overlays: a reused dep's (re-anchored) modulefile lives under
# MODULES/<build_id>/<ARCH>, not the flat per-arch tree, so a locally-built
# package's `prereq <reused-dep>` cannot resolve at enter/load time without it.
# Append every such overlay for this arch. Flat tree stays first (a local build
# wins over a reused copy); no overlays -> MODULEPATH is unchanged.
_bits_overlays=""
for _ov in "$WORK_DIR"/MODULES/*/"$ARCHITECTURE"; do
  [[ -d "$_ov" ]] && _bits_overlays="${_bits_overlays:+$_bits_overlays:}$_ov"
done
export MODULEPATH="$WORK_DIR/MODULES/$ARCHITECTURE${_bits_overlays:+":$_bits_overlays"}${MODULEPATH:+":$MODULEPATH"}"
unset _bits_overlays _ov
MODULEPATH=$(echo "$MODULEPATH" | sed -e 's/::*/:/g; s/^://; s/:$//')

# The CVMFS module trees of a community: with $BITS_CVMFS_PREFIX (which the
# CVMFS entry point sets; empty turns them off), <prefix>/<arch>/Modules/modulefiles;
# else, with a cvmfs.yaml in the recipe repository (here, or beside the work
# dir), the directory of its cvmfs_modules_template. For each deployed arch that
# is $ARCHITECTURE but for a trailing -opt/-dbg, in this order: the exact one,
# the one without build type (own_hash packages, the toolchain), -opt, -dbg.
# With cvmfs.yaml, no -a and no tree for $ARCHITECTURE, the arch is the one
# published for this host's CPU and OS, if there is exactly one (a compiler);
# else a note lists those published. They
# come after the local MODULEPATH and stay off it: each tree is used on its own
# (groupModulecmd), as its BASE/1.0 sets BASEDIR for it alone.
CVMFS_TREES=()
_tree=; _layout=
if [[ -n "${BITS_CVMFS_PREFIX+set}" ]]; then
  [[ -n "$BITS_CVMFS_PREFIX" ]] && _tree="${BITS_CVMFS_PREFIX%/}/{arch}/Modules/modulefiles"
else
  for _layout in "$PWD/cvmfs.yaml" "$(dirname "$WORK_DIR")/cvmfs.yaml" ""; do
    [[ -f "$_layout" ]] && break
  done
  if [[ -n "$_layout" ]]; then
    _p=$(layoutValue "$_layout" prefix)
    _tree=$(layoutValue "$_layout" cvmfs_modules_template)
    _tree=${_tree:-"{prefix}/{platform}/Modules/modulefiles/{pkg}"}
    _tree=${_tree//"{prefix}"/"${_p%/}"}; _tree=${_tree//"{platform}"/"{arch}"}
    # Usable: a prefix, and <dir>/{pkg} with {arch} once in <dir>, its only slot.
    _d=${_tree%"/{pkg}"}; _r=${_d//"{arch}"/}
    if [[ -z "$_p" || "$_d" == "$_tree" || "$_r" == "$_d" || "$_r" == *"{"* ||
          "${_d#*"{arch}"}" == *"{arch}"* ]]; then
      _tree=   # e.g. alice.bits' {install_dir}: no module trees for q/enter/load
    else
      _tree=$_d
    fi
  fi
fi
if [[ -n "$_tree" ]]; then
  cvmfsTrees "$_tree" "$ARCHITECTURE"
  # cvmfs.yaml, no -a, and nothing for the local arch: the one for this host.
  if [[ -n "$_layout" && -z "$_ARCH_GIVEN" && ${#CVMFS_TREES[@]} == 0 ]]; then
    _a=$(hostCvmfsArch "$_tree")
    [[ -z "$_a" ]] || cvmfsTrees "$_tree" "$_a-opt"
  fi
  if [[ -n "$_layout" && ${#CVMFS_TREES[@]} == 0 ]] && isModuleAction; then
    _p=$(publishedArchs "$_tree" | tr '\n' ' ' | sed 's/ $//')
    _a=$ARCHITECTURE; [[ -n "$_ARCH_GIVEN" ]] || _a="this host"
    [[ -z "$_p" ]] || printf "${EY}NOTE: no CVMFS module tree %s (%s) for %s; published: %s. Choose one: bits -a <arch> %s${EZ}\n" \
      "$_tree" "$_layout" "$_a" "$_p" "$ACTION" >&2
  fi
fi
unset _a _d _r _p _tree _layout
IGNORE_ERR="Unable to locate a modulefile for 'Toolchain/"
# -q (which unsets VERBOSE) silences environment-modules' "Loading <pkg>" /
# "Loading requirement:" progress lines so setenv/printenv/load/enter output can
# be captured/parsed cleanly. Honoured by environment-modules >= 4.
[[ -z "${VERBOSE:-}" ]] && export MODULES_VERBOSITY=silent

# --view: once modules are loaded *in process*, collapse the additive path
# variables (PATH / LD_LIBRARY_PATH / CMAKE_PREFIX_PATH / PKG_CONFIG_PATH /
# PYTHONPATH / ROOT_INCLUDE_PATH) onto a merged view of the loaded closure, so the
# environment stays small on big stacks. Each entry is remapped from its package
# prefix onto the view and de-duplicated; system entries are kept. The
# modulefiles' setenvs (<PKG>_ROOT, ROOTSYS, recipe env: variables) are left
# untouched. The view is cached per closure under $WORK_DIR/VIEWS/$ARCHITECTURE.
# Run the view helper so it can import bits_helpers WITHOUT polluting PYTHONPATH:
# the source dir is added via sys.path (passed as BITS_SELF), not the PYTHONPATH
# env var, so the collapse reads the *real* module PYTHONPATH and never echoes the
# bits source directory back into the user's environment.
_bitsView() {
  BITS_SELF="${BITSDIR}" "${BITS_PY:-python3}" ${BITS_PY:+-E -s} -c 'import os,sys; sys.path.insert(0, os.environ.get("BITS_SELF","")); from bits_helpers.view_cmd import main; sys.exit(main())' "$@"
}
applyView() {
  [[ $VIEWOPT == 1 ]] || return 0
  eval "$(_bitsView --work-dir "${WORK_DIR}" --arch "${ARCHITECTURE}" 2> /dev/null)"
}

case "$ACTION" in
  enter)
    [[ $BITSLVL == 1 ]] || \
      { printf "${ER}ERROR: already in an bits environment${EZ}\n" >&2; exit 1; }
    MODULES=$(normModules "${ARGS[@]}")
    _bt_mark preamble
    collectModules
    _bt_mark collectModules
    resolveModules $MODULES
    _bt_mark resolveModules
    PS1DEV=
    if [[ $DEVOPT == 1 ]];then
      localOnly
      PS1DEV=" (dev)"
      for MODULE in $MODULES; do
        # Reject module names containing path-traversal sequences to prevent
        # escaping the software directory (e.g. "../../evil").
        if [[ "$MODULE" == *..* ]]; then
          printf "${ER}ERROR: invalid module name '%s' (contains '..')${EZ}\n" "$MODULE" >&2
          exit 1
        fi
        . "$WORK_DIR/$ARCHITECTURE/$MODULE/etc/profile.d/init.sh"
      done
    else
      evalGroups add
    fi
    _bt_mark modulecmd
    [[ $UNAME == Darwin ]] && eval $(stripDyld)
    detectShell
    # A `view: true` package advertises BITS_VIEW in its modulefile; entering it
    # auto-enables --view (collapse PATH/LD_LIBRARY_PATH onto the merged view). Any
    # loaded module with the marker triggers it — fine while view packages are
    # top-level (lcg-view requires the metapackage, nothing requires lcg-view).
    # Consume-and-clear so the marker never leaks into the entered shell / a nested
    # `bits setenv` (applyView keys off VIEWOPT, not BITS_VIEW).
    [[ -n "${BITS_VIEW:-}" ]] && VIEWOPT=1
    unset BITS_VIEW
    applyView
    if [[ ! -z "$CLEAN_ENV" ]]; then
      case $MODULES_SHELL in
        sh|bash) export PS1="[$MODULES]$PS1DEV"' \w $> '   ;;
        ksh)     export PS1="[$MODULES]$PS1DEV"' $PWD $> ' ;;
        zsh)     export PS1="[$MODULES]$PS1DEV"' %~ %#> '  ;;
      esac
    fi
    $MODULECMD bash list
    if [[ $DEVOPT == 1 ]];then
      echo "*** Development env loaded for '$MODULES' ***" >&2
    else
      printf "${ET}Use ${EM}bits list${ET} to list loaded modules. " >&2
    fi
    printf "Use ${EM}exit${ET} to exit this environment.${EZ}\n" >&2
    exec ${CLEAN_ENV:+env $SHELL_NORC_ENV} $MODULES_SHELL ${CLEAN_ENV:+$SHELL_NORC_PARAM} -i
  ;;
  printenv|load|unload)
    [[ $ACTION == printenv ]] && ACTION=load
    MODULES=$(normModules "${ARGS[@]}")
    _bt_mark preamble
    if [[ $ACTION == load ]]; then
      collectModules; _bt_mark collectModules
      resolveModules $MODULES; _bt_mark resolveModules
    else
      resolveLoaded $MODULES
    fi
    [[ $VERBOSE == 1 ]] && printf "${ET}Use ${EM}bits list${ET} to list loaded modules.${EZ}\n" >&2
    if [[ $DEVOPT == 1 ]];then
      localOnly
      echo "Warning: Development mode for '$ACTION' is not supported via bits. Please remove '--dev' or run manually shown below" >&2
      echo "*** Please run following commands manually to load dev environment for '$MODULES' ***" >&2
      echo "" >&2
      echo "export WORK_DIR=$WORK_DIR" >&2
      for MODULE in $MODULES; do
        echo ". $WORK_DIR/$ARCHITECTURE/$MODULE/etc/profile.d/init.sh" >&2
      done
      echo "" >&2
      exit 0
    fi
    detectShell
    printGroups "$ACTION"
    # --view: emit the view-collapsed path overrides AFTER the module setup so they
    # win on eval. printenv/load only print (they don't load in-process), so the
    # closure is loaded in a subshell to compute the collapse; output is rendered
    # in the caller's shell syntax (sh export vs csh setenv).
    if [[ $VIEWOPT == 1 && $ACTION == load ]]; then
      _vshell=sh; case "$MODULES_SHELL" in csh|tcsh) _vshell=csh;; esac
      ( evalGroups load 2> /dev/null
        _bitsView --work-dir "${WORK_DIR}" --arch "${ARCHITECTURE}" --shell "$_vshell" 2> /dev/null )
    fi
    _bt_mark modulecmd
    [[ $UNAME == Darwin ]] && ( evalGroups "$ACTION" &> /dev/null; stripDyld )
    exit 0
  ;;
  setenv)
    [[ $DEVOPT == 1 ]] && echo "Warning: Development mode for '$ACTION' is not supported. Please remove '--dev'" >&2
    [[ -z "${COMMAND_IN_ENV[*]}" ]] && { printHelp "No command specified with -c"; false; }
    MODULES=$(normModules "${ARGS[@]}")
    collectModules
    resolveModules $MODULES
    evalGroups add
    [[ $UNAME == Darwin ]] && eval $(stripDyld)
    [[ -n "${BITS_VIEW:-}" ]] && VIEWOPT=1   # view: true package auto-enables --view
    unset BITS_VIEW                          # consume-and-clear (no leak into -c command)
    applyView
    exec "${COMMAND_IN_ENV[@]}"
  ;;
  q|query)
    [[ -z "${ARGS[0]}" ]] && SEARCH_CMD=cat || SEARCH_CMD=( grep -iE "${ARGS[0]}" )
    # Native module names are <pkg>/<version>. With a display prefix set (e.g.
    # via the aliBuild wrapper) reformat to <PREFIX>@<pkg>::<version>; with no
    # prefix, pass the native form through unchanged.
    if [[ -n "$BITS_PKG_PREFIX" ]]; then
      _fmt=( sed -e 's!^\([^/]*\)/\(.*\)$!'"${BITS_PKG_PREFIX}"'@\1::\2!' )
    else
      _fmt=( cat )
    fi
    # List straight from the install tree (no MODULES rebuild, no modulecmd).
    { listAvailableModules; listCvmfsModules; } | LC_ALL=C sort -u | "${SEARCH_CMD[@]}" | "${_fmt[@]}"
    exit ${PIPESTATUS[2]}  # SEARCH grep
  ;;
  avail)
    collectModules
    exec "$MODULECMD" bash avail
  ;;
  list)
    exec "$MODULECMD" bash list
  ;;
  modulecmd)
    collectModules
    exec "$MODULECMD" "${ARGS[@]}"
    ;;
  '')
    printHelp "What do you want to do?"
    ;;
  *)
    printHelp "Unknown command: $1"
  ;;
esac

false
