function usageError() {
  printf "${ER}bits: %s${EZ}\n" "$*" >&2
  echo "Run 'bits help' for the commands, 'bits help COMMAND' for one of them." >&2
}

function installHint() {
  if [[ $UNAME == Darwin ]]; then
    CMD='brew install modules'
  elif command -v apt-get > /dev/null 2>&1; then
    CMD='apt-get install environment-modules'
  elif command -v yum > /dev/null 2>&1; then
    CMD='yum install environment-modules'
  fi
  printf "${ER}ERROR: Environment Modules was not found on your system.\n" >&2
  if [[ -z "$CMD" ]]; then
    printf "       The package is usually called ${EM}environment-modules${ER}.\n" >&2
  else
    printf "       Get it with: ${EM}${CMD}\n" >&2
  fi
  printf "${EZ}"
}

function detectShell() {
  # Detect parent shell (fall back to bash)
  [[ -z "$MODULES_SHELL" ]] && MODULES_SHELL=$(ps -e -o pid,command | grep -E "^\s*$PPID\s+" | awk '{print $2}' | sed -e 's/^-\{0,1\}\(.*\)$/\1/')
  case "$MODULES_SHELL" in
    sh)                                      ;;
    csh|tcsh) SHELL_NORC_PARAM=-f            ;;
    ksh)      SHELL_NORC_ENV="ENV=/dev/null" ;;
    zsh)      SHELL_NORC_PARAM=--no-rcs      ;;
    *)        MODULES_SHELL=bash
              SHELL_NORC_PARAM=--norc        ;;
  esac
}

function _listPkgVersions() {
  # Emit the <pkg>/<version> directories under the install tree (the input the
  # module-collection loop consumes), and <family>/<pkg>/<version> ones for a
  # package_family.
  #
  # With BITS_CATALOG_LISTING=1 and the tree on CVMFS, first ask its serving
  # catalog via the bitsModules helper (one HTTP fetch + a local SQLite query);
  # it exits non-zero (fall-back contract) when its single-dedicated-catalog
  # convention does not hold. Off by default: a warm `find` is faster than the
  # helper's Python start (see catalogListing).
  local dir="$1" real bm
  real=$(readlink -f "$dir" 2> /dev/null || echo "$dir")
  if catalogListing && [[ "$real" == /cvmfs/* ]]; then
    if [[ -n "$BITS_PY" ]]; then bm="${BITSDIR}/bitsModules"
    else bm=$(command -v bitsModules 2> /dev/null || echo "${BITSDIR}/bitsModules"); fi
    if [[ -x "$bm" ]] && ${BITS_PY:+"$BITS_PY" -E -s} "$bm" "$dir" --depth2-dirs 2> /dev/null; then
      return 0
    fi
  fi
  local P V
  find "$dir" -maxdepth 2 -mindepth 2 2> /dev/null | while IFS= read -r P; do
    echo "$P"
    # package_family: <arch>/<family>/<pkg>/<version>, one level deeper. The
    # <pkg> directory of a family holds versions, and no etc/.
    if [[ -d "$P" && ! -L "$P" && ! -e "$P/etc" ]]; then
      for V in "$P"/*; do [[ -e "$V" || -L "$V" ]] && echo "$V"; done
    fi
  done
  return 0
}

function installDir() {
  # installDir PKG[/VERSION]: its directory in the install tree, under a
  # package_family directory if it is there.
  local d="$WORK_DIR/$ARCHITECTURE/$1" f
  if [[ ! -e "$d" ]]; then
    for f in "$WORK_DIR/$ARCHITECTURE"/*/"$1"; do [[ -e "$f" ]] && { d=$f; break; }; done
  fi
  echo "$d"
}

function collectModules() {
  [[ -z "$NO_WORK_DIR" ]] || return 0   # CVMFS modules only
  if [[ -n "$NO_REFRESH" ]]; then
    printf "${EY}WARNING: not updating modulefiles${EZ}\n" >&2
    return 0
  fi
  # Guard against empty variables before any rm to prevent accidental deletion
  # of paths like /MODULES/ if WORK_DIR or ARCHITECTURE is unset.
  [[ -n "$WORK_DIR" && -n "$ARCHITECTURE" ]] || \
    { printf "${ER}ERROR: WORK_DIR or ARCHITECTURE is empty; cannot refresh modules${EZ}\n" >&2; return 1; }
  local mroot="${WORK_DIR}/MODULES/${ARCHITECTURE}"
  local iroot="${WORK_DIR}/${ARCHITECTURE}"
  local stamp="$mroot/.bits_sync_stamp2"   # 2: package_family packages too
  mkdir -p "$mroot/BASE"
  cat > "$mroot/BASE/1.0" <<EOF
#%Module1.0
set base_path ${iroot}
setenv BASEDIR \$base_path
set osname [uname sysname]
set osarchitecture [uname machine]
EOF
  # Fast skip: the per-package stat/copy walk below is O(N) and, on a slow
  # filesystem, dominates load/enter (seconds). If nothing in the install tree
  # has changed since the last successful sync, the cache is already current —
  # detect that with one shallow `find -newer` (the same cheap traversal as a
  # bare find) and return. -maxdepth 2 includes the arch dir and the per-package
  # dirs, so package add/remove and version re-symlinks all bump a checked mtime.
  if [[ -f "$stamp" ]] && \
     [[ -z "$(find "$iroot" -maxdepth 2 -newer "$stamp" 2> /dev/null | head -1)" ]]; then
    return 0
  fi
  # Incremental sync: copy a modulefile into the cache only when it is missing
  # or newer than the cached copy, then drop cache entries whose source has
  # vanished. After a build with no module changes this copies nothing.
  local PKG PKGVER PKGNAME FAMILY rel src dest seen=$'\n'
  while read -r PKG; do
    [[ -n "$PKG" ]] || continue
    PKGVER=${PKG##*/}
    PKGNAME=${PKG%/*}; PKGNAME=${PKGNAME##*/}
    src="$PKG/etc/modulefiles/$PKGNAME"
    [[ -e "$src" ]] || continue
    rel=${PKG#"$iroot/"}; FAMILY=
    [[ "$rel" == */*/* ]] && FAMILY=${rel%%/*}
    dest="$mroot/$PKGNAME/$PKGVER"
    seen+="$PKGNAME/$PKGVER"$'\n'
    if [[ ! -e "$dest" || "$src" -nt "$dest" ]]; then
      mkdir -p "$mroot/$PKGNAME"
      if [[ -z "$FAMILY" ]]; then
        cp "$src" "$dest"
      else
        # A modulefile finds its package at $BASEDIR/<pkg>/<version>, the
        # layout on CVMFS; here the family is in the path too.
        # (The literal form bits-recipe-tools and alibuild-generate-module write.)
        local q=${PKGNAME//./\\.}
        sed -e "s|\$::env(BASEDIR)/$q/|\$::env(BASEDIR)/$FAMILY/$PKGNAME/|g" \
            -e "s|\$env(BASEDIR)/$q/|\$env(BASEDIR)/$FAMILY/$PKGNAME/|g" "$src" > "$dest"
      fi
    fi
  done < <(_listPkgVersions "$iroot")
  # Prune cache entries whose source modulefile no longer exists (deleted
  # package/version): those this listing did not see. One awk for the set
  # difference (the seen list goes in as a file: macOS awk takes no newlines
  # in -v values). Then remove the package directories left empty (BASE keeps
  # its 1.0).
  local DESTREL
  ( cd "$mroot" && find . -mindepth 2 -maxdepth 2 -type f ) 2> /dev/null | sed -e 's|^\./||' |
    awk 'NR == FNR { s[$0]; next } !($0 in s) && $0 !~ /^BASE\// { print }' <(printf '%s' "$seen") - |
    while IFS= read -r DESTREL; do rm -f "$mroot/$DESTREL"; done
  rmdir "$mroot"/*/ 2> /dev/null || true
  # Stamp the sync so the next call can fast-skip when nothing changed.
  : > "$stamp" 2> /dev/null || true
}

function listAvailableModules() {
  # Emit <pkg>/<version> for every installed package that ships a modulefile,
  # read straight from the install tree (the source of truth) via the same fast
  # path collectModules uses. This is what `bits q` lists: it avoids rebuilding
  # the MODULES cache (rm -rf + re-cp of every modulefile) and spawning
  # `modulecmd avail` just to enumerate — the two costs that make `q` slow on a
  # real filesystem. Output is unsorted; callers pipe through sort.
  local base="${WORK_DIR}/${ARCHITECTURE}" P pkgver pkgname
  [[ -z "$NO_WORK_DIR" && -d "$base" ]] || return 0
  while read -r P; do
    [[ -n "$P" ]] || continue
    pkgver=${P##*/}
    pkgname=${P%/*}; pkgname=${pkgname##*/}
    [[ -e "$P/etc/modulefiles/$pkgname" ]] && printf '%s/%s\n' "$pkgname" "$pkgver"
  done < <(_listPkgVersions "$base")
}

function normModules() {
  # Avoid interpolating $BITS_PKG_PREFIX into a sed expression: if the
  # prefix contains sed metacharacters or the delimiter it can inject
  # arbitrary sed commands.  Use pure bash string operations instead.
  local input="${*//,/ }"   # replace commas with spaces
  local result=()
  local token
  for token in $input; do
    token="${token#"${BITS_PKG_PREFIX}@"}"  # strip package prefix
    token="${token//::///}"                  # :: → /
    result+=("$token")
  done
  echo "${result[*]}"
}

function layoutValue() {
  # layoutValue FILE KEY: the value of a top-level `KEY: value` line of a
  # cvmfs.yaml (unquoted, without a trailing comment), empty if none.
  awk -v k="$2" 'index($0, k ":") == 1 {
      v = substr($0, length(k) + 2)
      sub(/^[ \t]+/, "", v); sub(/[ \t]+#.*$/, "", v); sub(/[ \t]+$/, "", v)
      if (v ~ /^".*"$/ || v ~ /^\047.*\047$/) v = substr(v, 2, length(v) - 2)
      print v; exit }' "$1"
}

function publishedArchs() {
  # publishedArchs TREE: the archs that have a module tree, TREE being its path
  # with {arch} in place of the arch.
  local pre=${1%%"{arch}"*} post=${1#*"{arch}"} d
  for d in "$pre"*; do [[ -d "$d$post" ]] && echo "${d#"$pre"}"; done
}

function archTokens() {
  # archTokens ARCH: its CPU (x86_64, aarch64, ...) and OS (el<N>, from
  # el/slc/alma/rhel/rocky/centos<N>, or ubuntu<NNNN>), as "CPU OS".
  local cpu= os=
  [[ "$1" =~ (x86[-_]64|aarch64|arm64|ppc64le|riscv64) ]] && cpu=${BASH_REMATCH[1]/x86-64/x86_64}
  if [[ "$1" =~ (^|[-_])(el|slc|alma|rhel|rocky|centos)([0-9]+)([-_]|$) ]]; then
    os=el${BASH_REMATCH[3]}
  elif [[ "$1" =~ (^|[-_])(ubuntu[0-9]+)([-_]|$) ]]; then
    os=${BASH_REMATCH[2]}
  fi
  echo "$cpu $os"
}

function hostMatches() {
  # hostMatches: the architectures on stdin built for this host's CPU and OS
  # (from /etc/os-release), as the CVMFS entry point picks its view.
  tokensMatch "$(uname -m)" "$( . /etc/os-release 2> /dev/null
        if [[ ${PLATFORM_ID:-} =~ ^platform:(el[0-9]+)$ ]]; then echo "${BASH_REMATCH[1]}"
        elif [[ ${ID:-} == ubuntu ]]; then echo "ubuntu${VERSION_ID//./}"
        fi )"
}

function tokensMatch() {
  # tokensMatch CPU OS: the architectures on stdin with that CPU token and that
  # OS (el<N> also as slc/alma/rhel/rocky/centos<N>); none without an OS.
  local cpu=$1 os=$2 a
  [[ -n "$cpu" && -n "$os" ]] || return 0
  while read -r a; do
    [[ "$a" == *"$cpu"* || "$a" == *"${cpu/_/-}"* ]] || continue
    case $os in
      el*) [[ "$a" =~ (^|[-_])(el|slc|alma|rhel|rocky|centos)${os#el}([-_]|$) ]] || continue ;;
      *)   [[ "$a" =~ (^|[-_])$os([-_]|$) ]] || continue ;;
    esac
    echo "$a"
  done
  return 0
}

function hostCvmfsArch() {
  # hostCvmfsArch TREE: the published build arch (without -opt/-dbg) for this
  # host (hostMatches), when exactly one matches.
  local a b bases=()
  while read -r a; do
    b=${a%-opt}; b=${b%-dbg}
    [[ " ${bases[*]} " == *" $b "* ]] || bases+=("$b")
  done < <(publishedArchs "$1" | hostMatches)
  (( ${#bases[@]} == 1 )) && echo "${bases[0]}"
  return 0
}

function isModuleAction() {
  case "$ACTION" in q|query|enter|printenv|load|setenv) return 0 ;; esac
  return 1
}

function cvmfsTrees() {
  # cvmfsTrees TREE ARCH: add to CVMFS_TREES the trees (TREE with {arch}) of
  # ARCH and of ARCH without its -opt/-dbg (the toolchain); ARCH without one is
  # -opt. Never the other build type. With install dirs in place of archs
  # (CVMFS_SLOT), ARCH if it is one, else the one with ARCH's CPU and OS.
  local a b t cpu os cands
  b=${2%-opt}; b=${b%-dbg}
  if [[ "$b" == "$2" ]]; then cands=("$2" "$2-opt"); else cands=("$2" "$b"); fi
  if [[ -n "$CVMFS_SLOT" ]]; then
    cands=("$2"); t=${1//"{arch}"/"$2"}
    if [[ ! -d "$t" ]]; then
      read -r cpu os <<< "$(archTokens "$2")"
      a=$(publishedArchs "$1" | tokensMatch "$cpu" "$os")
      [[ -n "$a" && "$a" != *$'\n'* ]] || return 0
      cands=("$a")
    fi
  fi
  CVMFS_ARCH=$2
  for a in "${cands[@]}"; do
    t=${1//"{arch}"/"$a"}
    [[ -d "$t" ]] || continue
    # Physical, as BASE/1.0 resolves its BASEDIR (file normalize): the same
    # paths whether BASE is loaded in the same run or was loaded before.
    t=$(cd "$t" && pwd -P)
    [[ " ${CVMFS_TREES[*]} " == *" $t "* ]] || CVMFS_TREES+=("$t")
  done
  return 0
}

function catalogListing() {
  # Whether to try the bitsModules catalog listing (BITS_CATALOG_LISTING=1).
  # Kept for later (e.g. selecting modules in SQL), but off: a directory walk
  # over a warm CVMFS cache takes milliseconds, the helper a Python start, and
  # it needs one catalog rooted at the tree with none nested below it.
  [[ "${BITS_CATALOG_LISTING:-}" == 1 ]]
}

function listCvmfsModules() {
  # Emit <pkg>/<version> for every modulefile in the CVMFS module trees (no
  # BASE), with find, or first the serving catalog (catalogListing), and in
  # their archives with --archive.
  local t i bm=
  (( ${#CVMFS_TREES[@]} )) || return 0
  if ! catalogListing; then :
  elif [[ -n "$BITS_PY" ]]; then bm="${BITSDIR}/bitsModules"
  else bm=$(command -v bitsModules 2> /dev/null || echo "${BITSDIR}/bitsModules"); fi
  for ((i = 0; i < ${#CVMFS_TREES[@]}; i++)); do
    t=${CVMFS_TREES[i]}
    { [[ -n "$bm" && -x "$bm" ]] && ${BITS_PY:+"$BITS_PY" -E -s} "$bm" "$t" 2> /dev/null; } ||
      ( cd "$t" && find . -mindepth 2 -maxdepth 2 \( -type f -o -type l \) | sed -e 's|^\./||' )
    t=${CVMFS_ARCHIVES[i]}
    [[ -z "$t" ]] || ( cd "$t" && find . -mindepth 2 -maxdepth 2 \( -type f -o -type l \) | sed -e 's|^\./||' )
  done | grep -E '^[^/.][^/]*/[^/.][^/]*$' | grep -v '^BASE/' || true
}

function resolveModules() {
  # Find the module tree of each module <pkg>[/<version>]: the local MODULEPATH
  # (the modulefile cache, reuse overlays, the user's own entries), then the
  # CVMFS trees in order (each with its archive, with --archive); the first that
  # has it wins. <pkg>/<version> is a
  # file there, a bare <pkg> a directory. Testing that directly is instant;
  # `modulecmd avail` (a full scan) runs only when no tree has it, so
  # default-version aliases still resolve locally. The `..` guard keeps the
  # direct test from matching path-traversal names (modulecmd rejects them).
  # Sets GROUP_TREE (a CVMFS tree, or "" for the local MODULEPATH) and
  # GROUP_MODS (its modules, space-separated), one entry per tree used, in tree
  # order.
  local M t i found mp trees=("" "${CVMFS_TREES[@]}") arcs=("" "${CVMFS_ARCHIVES[@]}") mods=()
  IFS=: read -r -a mp <<< "$MODULEPATH"
  for t in "${trees[@]}"; do mods+=(""); done
  for M in "$@"; do
    found=
    if [[ "$M" != *..* ]]; then
      for t in "${mp[@]}"; do [[ -n "$t" && -e "$t/$M" ]] && { found=0; break; }; done
      for ((i = 1; i < ${#trees[@]} && ${#found} == 0; i++)); do
        [[ -e "${trees[i]}/$M" || ( -n "${arcs[i]}" && -e "${arcs[i]}/$M" ) ]] && found=$i
      done
    fi
    [[ -z "$found" ]] && $MODULECMD bash -t avail 2>&1 | grep -qFx "$M" && found=0
    [[ -n "$found" ]] || { printf "${ER}ERROR: $M was not found${EZ}\n" >&2; return 1; }
    mods[found]+="${mods[found]:+ }$M"
  done
  GROUP_TREE=(); GROUP_MODS=()
  for ((i = 0; i < ${#trees[@]}; i++)); do
    [[ -n "${mods[i]}" ]] && { GROUP_TREE+=("${trees[i]}"); GROUP_MODS+=("${mods[i]}"); }
  done
  return 0
}

function resolveLoaded() {
  # For unload: group the modules by the tree they were loaded from, read from
  # _LMFILES_ (<tree>/<pkg>/<version>); any other module, e.g. one no tree has
  # any more, goes with the local MODULEPATH, as before. Sets GROUP_TREE and
  # GROUP_MODS as resolveModules does.
  local M f t a i found lm trees=("" "${CVMFS_TREES[@]}") arcs=("" "${CVMFS_ARCHIVES[@]}") mods=()
  IFS=: read -r -a lm <<< "${_LMFILES_:-}"
  for t in "${trees[@]}"; do mods+=(""); done
  for M in "$@"; do
    found=0
    for ((i = 1; i < ${#trees[@]} && found == 0; i++)); do
      for f in "${lm[@]}"; do
        for t in "${trees[i]}" ${arcs[i]:+"${arcs[i]}"}; do
          [[ "$f" == "$t/$M" || "$f" == "$t/$M/"* ]] && { found=$i; break 2; }
        done
      done
    done
    mods[found]+="${mods[found]:+ }$M"
  done
  GROUP_TREE=(); GROUP_MODS=()
  for ((i = 0; i < ${#trees[@]}; i++)); do
    [[ -n "${mods[i]}" ]] && { GROUP_TREE+=("${trees[i]}"); GROUP_MODS+=("${mods[i]}"); }
  done
  return 0
}

function releaseView() {
  # releaseView [auto]: the view of the requested release, when its setup.sh
  # can stand in for loading the modules (no modulecmd, no Python): one module
  # <pkg>/<ver-rev> from a CVMFS tree whose modules directory points to the
  # view (.<ver-rev>.view, a link to the view's marker for that module, see
  # bits cvmfs publish), and a view to use: --view or, with auto, a view: true
  # package (its modulefile sets BITS_VIEW). Prints the view directory, or
  # nothing.
  local t m p v link d
  [[ $DEVOPT != 1 && ${#GROUP_TREE[@]} == 1 && -n "${GROUP_TREE[0]}" ]] || return 0
  m=${GROUP_MODS[0]}
  [[ $m == */* && $m != *" "* ]] || return 0
  t=${GROUP_TREE[0]}; p=${m%%/*}; v=${m#*/}
  link="$t/$p/.$v.view"
  [[ -f "$link" && -f "$t/$m" ]] || return 0
  [[ $VIEWOPT == 1 ]] || { [[ ${1:-} == auto ]] &&
    grep -q '^setenv BITS_VIEW 1$' "$t/$m" 2> /dev/null; } || return 0
  d=$(readlink "$link") || return 0
  [[ $d == /* ]] || d="$t/$p/$d"
  d=$(cd "$(dirname "$d")" 2> /dev/null && pwd -P) || return 0
  [[ -f "$d/setup.sh" && -f "$d/setup.csh" ]] && echo "$d"
  return 0
}

function sourceReleaseView() {
  # The release view's setup.sh in this shell; BITS_VIEW, which it sets to
  # the view, is cleared as after loading the modules.
  . "$1/setup.sh"
  unset BITS_VIEW
}

function localOnly() {
  # --dev sources the packages' own init.sh from the work directory: local
  # modules only.
  local i cv=
  for ((i = 0; i < ${#GROUP_TREE[@]}; i++)); do
    [[ -n "${GROUP_TREE[i]}" ]] && cv+=" ${GROUP_MODS[i]}"
  done
  [[ -z "$cv" ]] && return 0
  printf "${ER}ERROR: --dev works with local modules only, not with CVMFS ones:%s${EZ}\n" "$cv" >&2
  return 1
}

function groupModulecmd() {
  # groupModulecmd SHELL ACTION I: modulecmd for the modules of group I against
  # their tree alone (MODULEPATH = that tree, the local one as it is), so their
  # dependencies come from the same tree. BASEDIR is set to the tree's packages:
  # bits modulefiles find their package through it, and those of a second tree
  # skip their BASE/1.0 when the first tree's is loaded already.
  # A tree's archive (--archive) comes after it, with the same packages.
  local t="${GROUP_TREE[$3]}" mp i
  mp=$t
  for ((i = 0; i < ${#CVMFS_TREES[@]}; i++)); do
    [[ "${CVMFS_TREES[i]}" == "$t" && -n "${CVMFS_ARCHIVES[i]}" ]] && mp+=":${CVMFS_ARCHIVES[i]}"
  done
  if [[ -z "$t" && -n "$NO_WORK_DIR" ]]; then
    $MODULECMD "$1" "$2" ${GROUP_MODS[$3]}   # from the user's own MODULEPATH
  elif [[ -z "$t" ]]; then
    BASEDIR="${WORK_DIR}/${ARCHITECTURE}" $MODULECMD "$1" "$2" ${GROUP_MODS[$3]}
  else
    MODULEPATH="$mp" BASEDIR="${t%/Modules/modulefiles}/Packages" $MODULECMD "$1" "$2" ${GROUP_MODS[$3]}
  fi
}

function evalGroups() {
  # evalGroups ACTION: apply every group in this shell, in order, each on the
  # result of the previous one. After CVMFS groups BASEDIR is the local one
  # again, so that a local module loaded by hand later (BASE/1.0 being loaded
  # already) finds its package.
  local i
  for ((i = 0; i < ${#GROUP_TREE[@]}; i++)); do
    eval "$(groupModulecmd bash "$1" "$i" 2> >(grep -v "$IGNORE_ERR" >&2))"
  done
  [[ -z "${GROUP_TREE[*]}" || -n "$NO_WORK_DIR" ]] || export BASEDIR="${WORK_DIR}/${ARCHITECTURE}"
}

function printGroups() {
  # printGroups ACTION: print every group's commands for $MODULES_SHELL. Each
  # group is run after the previous one is applied here, and modulecmd prints
  # whole values, so the output evaluated in order gives what evalGroups gives.
  local i n=${#GROUP_TREE[@]}
  for ((i = 0; i < n; i++)); do
    groupModulecmd "$MODULES_SHELL" "$1" "$i" 2> >(grep -v "$IGNORE_ERR" >&2)
    (( i + 1 < n )) && eval "$(groupModulecmd bash "$1" "$i" 2> /dev/null)"
  done
  return 0
}

function stripDyld() {
  # Succeeds with nothing to strip too: callers run under set -e.
  TO_STRIP=$( (typeset | grep ^DYLD | cut -d= -f1 | grep '_modshare$' | xargs echo ) 2> /dev/null )
  if [ -n "$TO_STRIP" ]; then echo unset $TO_STRIP; echo ';'; fi
}

function _bt_mark() {
  # Print elapsed wall time since the previous mark (only when BITS_TIMING set).
  [[ -n "${BITS_TIMING:-}" ]] || return 0
  local now="${EPOCHREALTIME/,/.}"; now="${now:-$(date +%s.%N 2>/dev/null || echo 0)}"
  [[ -n "${_BT_PREV:-}" ]] && \
    awk -v a="$_BT_PREV" -v b="$now" -v l="$1" 'BEGIN{printf "[timing] %-14s %7.3fs\n", l, b-a}' >&2
  _BT_PREV="$now"
}

function configBits() {
