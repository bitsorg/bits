# `bits --community NAME <sub-command> …` (first, before the sub-command): the
# same as $BITS_COMMUNITY=NAME, e.g. for a grid job's command line.
while [[ ${1:-} == --community || ${1:-} == --community=* ]]; do
  if [[ $1 == --community ]]; then _bits_c=${2-}; shift $(( $# > 1 ? 2 : 1 )); else _bits_c=${1#*=}; shift; fi
  [[ $_bits_c =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || { echo "bits: --community needs a community name, not '$_bits_c'" >&2; exit 1; }
  export BITS_COMMUNITY=$(printf %s "$_bits_c" | tr '[:lower:]' '[:upper:]')
  unset _bits_c
done

# bits, bits -h|--help|help: the commands; bits help COMMAND: COMMAND --help.
case "${1:-}" in
  "")          printHelp >&2; exit 1 ;;
  -h|--help)   printHelp; exit 0 ;;
  help)        shift; (( $# )) || { printHelp; exit 0; }
               set -- "$@" --help ;;
esac

# `.bitsuse` saved-arg profile (see `bits use`): inject the [common] + [<action>]
# tokens right after the action, BEFORE anything is parsed, so both the build
# path and the module commands (q/enter/…, which read ARGV below) see them.
# The profile is a local ./.bitsuse (or legacy ./.bitscmd) or this directory's
# record under ~/.bits/use (~/.bits/use/<first 16 of sha256 of its real path>.use,
# as bits_use names it); python reads it only when one is there, so the
# environment commands start no Python otherwise. `use` opts out; explicit args
# stay last.
function bitsUseProfile() {
  # Whether a profile may apply here (also when the record's name cannot be
  # computed: python then decides).
  [[ -f .bitsuse || -f .bitscmd ]] && return 0
  [[ -d "$HOME/.bits/use" ]] || return 1
  local d k
  d=$(pwd -P) || return 0
  k=$( { printf %s "$d" | sha256sum || printf %s "$d" | shasum -a 256; } 2> /dev/null | cut -c1-16)
  [[ ${#k} != 16 || -f "$HOME/.bits/use/$k.use" ]]
}
if bitsUseProfile; then
  _bits_prof=()
  while IFS= read -r -d '' _bits_t; do _bits_prof+=("$_bits_t"); done \
    < <(BITS_SELF="${BITSDIR}" "${BITS_PY:-python3}" ${BITS_PY:+-E -s} -c 'import os,sys; sys.path.insert(0, os.environ.get("BITS_SELF","")); from bits_helpers.bits_use import main; sys.exit(main())' --rewrite0 -- "$@")
  [[ ${#_bits_prof[@]} -gt 0 ]] && set -- "${_bits_prof[@]}"
  unset _bits_prof _bits_t
fi

ARGV=("$@"); ARGC=$#   # ARGC must be a plain integer, not an array

# `bits preload …` is handled up-front (before module/dispatch setup) so its own
# `--config <yaml>` is not consumed by later processing. Post-publish CVMFS
# filebundle generator: traces the
# deployed tests (strace, optionally --docker) and writes .cvmfsbundle-* into one
# tar. Self-contained; needs no work dir. Uses the raw ARGV, unmangled.
if [[ "${ARGV[0]:-}" == "preload" ]]; then
  BITS_SELF="${BITSDIR}" exec "${BITS_PY:-python3}" ${BITS_PY:+-E -s} -c 'import os,sys; sys.path.insert(0, os.environ.get("BITS_SELF","")); from bits_helpers.preload_cmd import main; sys.exit(main())' "${ARGV[@]:1}"
fi

# `bits overlay <format> …` — emit a consumable overlay of the built closure in a
# named format (bits_helpers/overlay/<format>.py, or dropped in via
# $BITS_OVERLAY_PLUGINS). Self-contained like preload; dispatched before the
# build/defaults arg setup. Generic verb — nothing CERN-specific in the core CLI.
if [[ "${ARGV[0]:-}" == "overlay" ]]; then
  BITS_SELF="${BITSDIR}" exec "${BITS_PY:-python3}" ${BITS_PY:+-E -s} -c 'import os,sys; sys.path.insert(0, os.environ.get("BITS_SELF","")); from bits_helpers.overlay import main; sys.exit(main())' "${ARGV[@]:1}"
fi

# `bits lcg-view …` — DEPRECATED alias for `bits overlay lcg` (same arguments).
# Kept so any straggler still calling it works; new recipes use `bits overlay lcg`.
if [[ "${ARGV[0]:-}" == "lcg-view" ]]; then
  echo "bits: 'lcg-view' is deprecated; use 'bits overlay lcg'." >&2
  BITS_SELF="${BITSDIR}" exec "${BITS_PY:-python3}" ${BITS_PY:+-E -s} -c 'import os,sys; sys.path.insert(0, os.environ.get("BITS_SELF","")); from bits_helpers.overlay.lcg import main; sys.exit(main())' "${ARGV[@]:1}"
fi

# Optional phase timing for diagnosing slow load/enter: set BITS_TIMING=1 to
# print the wall time of each phase to stderr. Uses bash EPOCHREALTIME (>=5),
# else GNU date; no overhead when unset.
[[ -n "${BITS_TIMING:-}" ]] && _BT_PREV="${EPOCHREALTIME/,/.}" && _BT_PREV="${_BT_PREV:-$(date +%s.%N 2>/dev/null || echo 0)}"

